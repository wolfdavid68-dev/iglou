{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/aliment/**", "destination": "/aliment/[id].html" },
      { "source": "/appareil/**", "destination": "/appareil/[id].html" },
      { "source": "/recette/**", "destination": "/recette/[id].html" }
    ]
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "singleProjectMode": true
  }
}
