{
  "hosting": [
    {
      "site": "iglou",
      "public": "dist",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ],
      "rewrites": [
        { "source": "/aliment/**", "destination": "/aliment/[id].html" },
        { "source": "/appareil/**", "destination": "/appareil/[id].html" },
        { "source": "/recette/**", "destination": "/recette/[id].html" }
      ]
    },
    {
      "site": "congelateur-v91vd",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*"],
      "redirects": [
        { "regex": "^/(.*)$", "destination": "https://iglou.web.app/:1", "type": 301 }
      ]
    }
  ]
}
