{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://grateful-fennec-82.convex.cloud" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_CONVEX_URL": "https://grateful-fennec-82.convex.cloud" }
    }
  },
  "submit": {
    "production": {}
  }
}
