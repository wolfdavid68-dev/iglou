rules_version = '2';

// Règles de sécurité Firestore.
// Principe : un utilisateur ne lit et ne modifie QUE les données des maisons
// dont il est membre. La règle du maximum (quantiteMax >= quantite) est
// garantie ici, quel que soit le téléphone qui écrit.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function connecte() {
      return request.auth != null;
    }
    function moi() {
      return request.auth.uid;
    }
    function cheminMaison(maisonId) {
      return /databases/$(database)/documents/maisons/$(maisonId);
    }
    function cheminMembre(maisonId, uid) {
      return /databases/$(database)/documents/maisons/$(maisonId)/membres/$(uid);
    }
    function cheminInvitation(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function estMembre(maisonId) {
      return connecte() && exists(cheminMembre(maisonId, moi()));
    }
    function estProprietaire(maisonId) {
      return connecte()
        && exists(cheminMembre(maisonId, moi()))
        && get(cheminMembre(maisonId, moi())).data.role == 'proprietaire';
    }
    function donnees() {
      return request.resource.data;
    }
    function texte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function texteOuNul(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function unite(v) {
      return v in ['pièce', 'g', 'kg', 'L', 'portion'];
    }
    function codeInvitation(v) {
      return v is string && v.matches('^[A-Z0-9]{6}$');
    }
    // Seuls ces champs changent dans cette mise à jour.
    function changeSeulement(champs) {
      return donnees().diff(resource.data).affectedKeys().hasOnly(champs);
    }

    // ---------- Profils ----------
    match /profils/{uid} {
      allow read: if connecte() && moi() == uid;
      allow create, update: if connecte() && moi() == uid
        && donnees().keys().hasOnly(['prenom', 'createdAt'])
        && texte(donnees().prenom, 40);
      // Suppression du compte : chacun efface son propre profil.
      allow delete: if connecte() && moi() == uid;
    }

    // ---------- Invitations : lecture à l'unité par code, jamais de liste ----------
    match /invitations/{code} {
      allow get: if connecte();
      allow list: if false;
      // Créée par le propriétaire, dans le même lot que la maison ou que le
      // changement de code (getAfter = état après le lot).
      allow create: if connecte()
        && codeInvitation(code)
        && donnees().keys().hasOnly(['maisonId'])
        && getAfter(cheminMembre(donnees().maisonId, moi())).data.role == 'proprietaire'
        && getAfter(cheminMaison(donnees().maisonId)).data.codeInvitation == code;
      allow delete: if estProprietaire(resource.data.maisonId)
        || !exists(cheminMaison(resource.data.maisonId));
    }

    // ---------- Signalements de bugs : envoi seul, lus depuis la console Firebase ----------
    match /signalements/{signalementId} {
      allow create: if connecte()
        && donnees().keys().hasOnly(['uid', 'email', 'prenom', 'maisonId', 'message', 'appareil', 'systeme', 'versionApp', 'createdAt'])
        && donnees().keys().hasAll(['uid', 'email', 'prenom', 'maisonId', 'message', 'appareil', 'systeme', 'versionApp', 'createdAt'])
        && donnees().uid == moi()
        && donnees().email == request.auth.token.get('email', '')
        && texteOuNul(donnees().prenom, 40)
        && donnees().maisonId is string
        && texte(donnees().message, 2000)
        && texteOuNul(donnees().appareil, 100)
        && texteOuNul(donnees().systeme, 60)
        && texteOuNul(donnees().versionApp, 30)
        && donnees().createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- Liste de mes maisons (requête collectionGroup sur « membres ») ----------
    match /{chemin=**}/membres/{uid} {
      allow read: if connecte() && resource.data.uid == moi();
    }

    // ---------- Maisons ----------
    match /maisons/{maisonId} {
      allow read: if estMembre(maisonId);

      allow create: if connecte()
        && donnees().keys().hasOnly(['nom', 'codeInvitation', 'createdBy', 'createdAt'])
        && texte(donnees().nom, 60)
        && codeInvitation(donnees().codeInvitation)
        && donnees().createdBy == moi()
        && getAfter(cheminMembre(maisonId, moi())).data.role == 'proprietaire'
        && getAfter(cheminInvitation(donnees().codeInvitation)).data.maisonId == maisonId;

      // Renommer : tout membre. Changer le code : propriétaire, avec la nouvelle invitation.
      allow update: if estMembre(maisonId)
        && changeSeulement(['nom', 'codeInvitation'])
        && texte(donnees().nom, 60)
        && (donnees().codeInvitation == resource.data.codeInvitation
            || (estProprietaire(maisonId)
                && codeInvitation(donnees().codeInvitation)
                && getAfter(cheminInvitation(donnees().codeInvitation)).data.maisonId == maisonId
                && !existsAfter(cheminInvitation(resource.data.codeInvitation))));

      allow delete: if estProprietaire(maisonId);

      // ---------- Membres ----------
      match /membres/{uid} {
        allow read: if estMembre(maisonId);

        allow create: if connecte() && uid == moi()
          && donnees().keys().hasOnly(['uid', 'maisonId', 'prenom', 'role', 'joinedAt', 'code'])
          && donnees().uid == uid
          && donnees().maisonId == maisonId
          && texte(donnees().prenom, 40)
          && (
            // Fondateur : la maison est créée dans le même lot, par moi.
            (donnees().role == 'proprietaire'
              && !exists(cheminMaison(maisonId))
              && getAfter(cheminMaison(maisonId)).data.createdBy == moi())
            ||
            // Invité : le code fourni est le code actuel de la maison.
            (donnees().role == 'membre'
              && exists(cheminMaison(maisonId))
              && donnees().code == get(cheminMaison(maisonId)).data.codeInvitation)
          );

        // Je peux changer mon prénom affiché, rien d'autre. Le propriétaire peut
        // passer la main à un membre (avant de supprimer son compte).
        allow update: if (connecte() && uid == moi()
            && changeSeulement(['prenom'])
            && texte(donnees().prenom, 40))
          || (estProprietaire(maisonId) && uid != moi()
            && changeSeulement(['role'])
            && resource.data.role == 'membre'
            && donnees().role == 'proprietaire');

        // Quitter (sauf le propriétaire) ; le propriétaire peut retirer un membre
        // ou tout supprimer avec la maison.
        allow delete: if connecte()
          && ((uid == moi() && resource.data.role != 'proprietaire') || estProprietaire(maisonId));
      }

      // ---------- Appareils ----------
      match /appareils/{appareilId} {
        allow read, delete: if estMembre(maisonId);
        allow create, update: if estMembre(maisonId)
          && donnees().keys().hasOnly(['nom', 'type', 'ordre', 'createdAt'])
          && texte(donnees().nom, 60)
          && donnees().type in ['frigo', 'congelateur']
          && donnees().ordre is int;
      }

      // ---------- Tiroirs ----------
      match /tiroirs/{tiroirId} {
        allow read, delete: if estMembre(maisonId);
        allow create, update: if estMembre(maisonId)
          && donnees().keys().hasOnly(['appareilId', 'nom', 'ordre'])
          && donnees().appareilId is string
          && texte(donnees().nom, 60)
          && donnees().ordre is int;
      }

      // ---------- Aliments ----------
      match /aliments/{alimentId} {
        function alimentValide() {
          let d = donnees();
          return d.keys().hasOnly(['tiroirId', 'appareilId', 'nom', 'quantite', 'quantiteMax', 'unite',
              'datePeremption', 'note', 'dansPanier', 'achatQuantite', 'ajoutePar', 'ajouteParPrenom',
              'modifiePar', 'createdAt', 'updatedAt'])
            && d.tiroirId is string && d.appareilId is string
            && texte(d.nom, 80)
            && d.quantite is number && d.quantite >= 0
            && d.quantiteMax is number && d.quantiteMax > 0
            // Règle du maximum : le stock plein n'est jamais inférieur à la quantité.
            && d.quantiteMax >= d.quantite
            && unite(d.unite)
            && texteOuNul(d.datePeremption, 10)
            && texteOuNul(d.note, 500)
            && d.dansPanier is bool
            && (d.achatQuantite == null || (d.achatQuantite is number && d.achatQuantite > 0))
            && d.modifiePar == moi()
            && d.ajoutePar is string
            && texte(d.ajouteParPrenom, 40);
        }
        allow read, delete: if estMembre(maisonId);
        allow create: if estMembre(maisonId) && alimentValide();
        // L'auteur et la date d'ajout ne changent jamais.
        allow update: if estMembre(maisonId) && alimentValide()
          && donnees().ajoutePar == resource.data.ajoutePar
          && donnees().createdAt == resource.data.createdAt;
      }

      // ---------- Articles de courses ajoutés à la main ----------
      match /coursesLibres/{libreId} {
        allow read, delete: if estMembre(maisonId);
        allow create, update: if estMembre(maisonId)
          && donnees().keys().hasOnly(['nom', 'quantite', 'unite', 'dansPanier', 'ajoutePar', 'createdAt'])
          && texte(donnees().nom, 80)
          && donnees().quantite is number && donnees().quantite > 0
          && unite(donnees().unite)
          && donnees().dansPanier is bool
          && donnees().ajoutePar is string;
      }

      // ---------- Historique des sorties (statistiques) ----------
      // Journal en ajout seul : une sortie ne se modifie jamais après coup.
      match /consommations/{consoId} {
        allow read: if estMembre(maisonId);
        allow create: if estMembre(maisonId)
          && donnees().keys().hasOnly(['nom', 'quantite', 'unite', 'appareilId', 'par', 'at'])
          && donnees().keys().hasAll(['nom', 'quantite', 'unite', 'appareilId', 'par', 'at'])
          && texte(donnees().nom, 80)
          && donnees().quantite is number && donnees().quantite > 0
          && unite(donnees().unite)
          && donnees().appareilId is string
          && donnees().par == moi()
          && donnees().at == request.time;
        allow update: if false;
        allow delete: if estProprietaire(maisonId);
      }
    }
  }
}
